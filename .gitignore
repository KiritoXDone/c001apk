# 默认忽略，只放行必要目录与构建输入。
*
!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/README.md
!/CHANGELOG.md
!/LICENSE
!/renovate.json
!/build.gradle.kts
!/settings.gradle.kts
!/gradle.properties
!/gradlew
!/gradlew.bat

# Gradle 版本目录与完整启动器。
!/gradle/
!/gradle/libs.versions.toml
!/gradle/wrapper/
!/gradle/wrapper/gradle-wrapper.jar
!/gradle/wrapper/gradle-wrapper.properties

# 仅开放现有四模块，源码和资源按所在目录与扩展名放行。
!/app/
!/app/build.gradle.kts
!/app/proguard-rules.pro
!/app/src/
!/app/src/**/
!/app/src/**/*.kt
!/app/src/**/*.java
!/app/src/**/AndroidManifest.xml
!/app/src/**/res/**/*.xml
!/app/src/**/res/**/*.png
!/app/src/**/res/**/*.webp
!/mojito/
!/mojito/build.gradle.kts
!/mojito/proguard-rules.pro
!/mojito/src/
!/mojito/src/**/
!/mojito/src/**/*.kt
!/mojito/src/**/*.java
!/mojito/src/**/AndroidManifest.xml
!/mojito/src/**/res/**/*.xml
!/mojito/src/**/res/**/*.png
!/mojito/src/**/res/**/*.webp
!/SketchImageViewLoader/
!/SketchImageViewLoader/build.gradle.kts
!/SketchImageViewLoader/proguard-rules.pro
!/SketchImageViewLoader/consumer-rules.pro
!/SketchImageViewLoader/src/
!/SketchImageViewLoader/src/**/
!/SketchImageViewLoader/src/**/*.kt
!/SketchImageViewLoader/src/**/*.java
!/SketchImageViewLoader/src/**/AndroidManifest.xml
!/SketchImageViewLoader/src/**/res/**/*.xml
!/SketchImageViewLoader/src/**/res/**/*.png
!/SketchImageViewLoader/src/**/res/**/*.webp
!/media-support/
!/media-support/build.gradle.kts
!/media-support/src/
!/media-support/src/**/
!/media-support/src/**/*.kt
!/media-support/src/**/*.java
!/media-support/src/**/AndroidManifest.xml
!/media-support/src/**/res/**/*.xml
!/media-support/src/**/res/**/*.png
!/media-support/src/**/res/**/*.webp
!/app/src/main/ic_launcher-playstore.png
!/app/src/main/proto/*.proto
!/app/src/main/assets/devicemodel.txt
!/app/src/main/assets/licenses/
!/app/src/main/assets/licenses/*.txt
!/app/src/main/assets/**/*.png
!/app/src/test/resources/**/*.json

# 构建入口、验证工具与工作流。
!/scripts/
!/scripts/*.py
!/tools/
!/tools/*.py
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml

# 长期维护文档与界面预览，不开放本地记录目录。
!/docs/
!/docs/*.md
!/docs/screenshots/
!/docs/screenshots/*.png

# 共享技能逐项放行，会话与个人设置保持本地。
!/.codex/
!/.codex/skills/
!/.codex/skills/commit/
!/.codex/skills/commit/SKILL.md
!/.codex/skills/version-bump/
!/.codex/skills/version-bump/SKILL.md
!/.codex/skills/pr/
!/.codex/skills/pr/SKILL.md
!/.claude/
!/.claude/skills/
!/.claude/skills/commit/
!/.claude/skills/commit/SKILL.md
!/.claude/skills/version-bump/
!/.claude/skills/version-bump/SKILL.md
!/.claude/skills/pr/
!/.claude/skills/pr/SKILL.md

# 即使位于源码目录，生成内容、凭据与工具状态也不入库。
**/build/
**/.gradle/
**/.kotlin/
**/.idea/
**/.cxx/
**/.externalNativeBuild/
**/__pycache__/
**/local.properties
**/.env*
**/google-services.json
*.apk
*.aab
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
*.log
*.har
*.hsr

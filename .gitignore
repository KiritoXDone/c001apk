# 默认忽略，只放行必要目录与构建输入。
*
!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/README.md
!/LICENSE
!/renovate.json
!/build.gradle.kts
!/settings.gradle.kts
!/gradle.properties
!/gradlew
!/gradlew.bat

# Gradle 版本目录与完整启动器。
!/gradle/
!/gradle/libs.versions.toml
!/gradle/wrapper/
!/gradle/wrapper/gradle-wrapper.jar
!/gradle/wrapper/gradle-wrapper.properties

# 应用模块。
!/app/
!/app/build.gradle.kts
!/app/proguard-rules.pro
!/app/src/
!/app/src/**/
!/app/src/**/*.kt
!/app/src/**/AndroidManifest.xml
!/app/src/**/res/**/*.xml
!/app/src/**/res/**/*.png
!/app/src/**/res/**/*.webp
!/app/src/main/ic_launcher-playstore.png
!/app/src/main/proto/*.proto
!/app/src/main/assets/devicemodel.txt
!/app/src/main/assets/licenses/
!/app/src/main/assets/licenses/*.txt
!/app/src/main/assets/**/*.png
!/app/src/test/resources/**/*.json

# 构建入口、验证工具与工作流。
!/scripts/
!/scripts/*.py
!/scripts/build_support/
!/scripts/build_support/**/*.py
!/tools/
!/tools/*.py
!/.github/
!/.github/CHANGELOG.md
!/.github/workflows/
!/.github/workflows/build-release.yml
!/.github/scripts/
!/.github/scripts/release_source.py
!/.github/scripts/release_ci.py
!/.github/scripts/release_package.py

# 长期维护文档与界面预览，不开放本地记录目录。
!/docs/
!/docs/*.md
!/docs/screenshots/
!/docs/screenshots/*.png

# Pi 项目仅共享技能入口配置。
!/.pi/
!/.pi/settings.json

# 共享技能逐项放行，会话与个人设置保持本地。
!/.codex/
!/.codex/skills/
!/.codex/skills/**/
!/.codex/skills/**/SKILL.md
!/.codex/skills/privacy-review/scripts/**/*.py
!/.codex/skills/**/guides/**/*.md
!/.codex/skills/app-debug/scripts/**/*.py
!/.claude/
!/.claude/skills/
!/.claude/skills/**/
!/.claude/skills/**/SKILL.md
!/.claude/skills/privacy-review/scripts/**/*.py
!/.claude/skills/**/guides/**/*.md
!/.claude/skills/app-debug/scripts/**/*.py

# 即使位于源码目录，生成内容、凭据与工具状态也不入库。
**/build/
**/.gradle/
**/.kotlin/
**/.idea/
**/.cxx/
**/.externalNativeBuild/
**/__pycache__/
**/local.properties
**/.env*
**/google-services.json
*.apk
*.aab
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
*.log
*.har
*.hsr
